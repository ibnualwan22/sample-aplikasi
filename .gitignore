# Environment variables — JANGAN commit ke Git!
.env
.env.*

# Firebase Android config — berisi kunci API proyek; build rilis hanya
# butuh file lokal (disalin dari ~/workspace/siakad-notifikasi/firebase/).
/android/app/google-services.json

